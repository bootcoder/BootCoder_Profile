<div class='container-fluid spacer'>
  <div class="social-network row">
      <div class='col-6'>
        <a href="https://github.com/bootcoder/BootCoder_Profile" class='footer-link' >
          <span class='footer-link-text'>
            Source Code<br>
          </span>
          <span class="fa-stack fa-2x">
            <i class="fa fa-circle fa-stack-2x"></i>
            <i class="fa fa-github-alt fa-stack-1x fa-inverse"></i>
          </span>
        </a>
      </div>
      <div class='col-6'>
        <%= link_to(resume_path, class: 'footer-link') do %>
          <span class='footer-link-text'>
            Careers<br>
          </span>
          <span class="fa-stack fa-2x">
            <i class="fa fa-circle fa-stack-2x"></i>
            <i class="fa fa-file fa-stack-1x fa-inverse"></i>
          </span>
        <% end %>
      </div>
  </div>

  <div class="social-network row">
    <div class='col-3'>
      <a href="https://github.com/bootcoder" target="_blank" class='footer-link' >
        <span class='footer-link-text'>
          GitHub<br>
        </span>
        <span class="fa-stack fa-2x">
          <i class="fa fa-circle fa-stack-2x"></i>
          <i class="fa fa-github fa-stack-1x fa-inverse"></i>
        </span>
      </a>
    </div>
    <div class='col-3'>
      <a href="http://www.linkedin.com/in/bootcoder/" target="_blank" class='footer-link' >
        <span class='footer-link-text'>
          LinkedIn<br>
        </span>
        <span class="fa-stack fa-2x">
          <i class="fa fa-circle fa-stack-2x"></i>
          <i class="fa fa-linkedin fa-stack-1x fa-inverse"></i>
        </span>
      </a>
    </div>
    <div class='col-3'>
      <a href="https://www.facebook.com/BlueTyGator" target="_blank" class='footer-link' >
