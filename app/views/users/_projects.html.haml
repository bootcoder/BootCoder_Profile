-# locals: projects: (collection), row_count: (Integer, default 2)
- projects      ||= @projects || []
- row_count     ||= 2
- groups          = projects.in_groups(row_count, false)
- speeds          = [0.25, -0.15, 0.2, -0.18, 0.12, -0.1] # recycle if > 6 rows

%section#projects.bc-projects.py-6{ data: { row_count: row_count } }
  .container-xxl
    %h2.display-6.fw-bold.mb-4.text-center Projects

    - groups.each_with_index do |group, idx|
      - speed = speeds[idx % speeds.length]
      .bc-parallax-row{ data: { speed: speed } }
        .row.flex-nowrap.overflow-auto.gx-4.pb-3
          - group.each do |project|
            - modal_id = "projectModal-#{project.id}"
            .col-10.col-sm-6.col-md-4.col-lg-3
              %a.project-3d.card.border-0.shadow-sm.text-reset.text-decoration-none{ href: "##{modal_id}", data: { bs_toggle: "modal", bs_target: "##{modal_id}" }, role: "button", aria: { controls: modal_id } }
                .ratio.ratio-16x9
                  %img.card-img-top{ src: image_path(project.project_img), alt: "#{project.project_name} screenshot", loading: "lazy" }
                .card-body
                  %h5.card-title.mb-0= project.project_name
                  %small.text-muted
                    = [project.project_feature_lang, project.project_state.presence].compact.join(" \u2014 ")

  -# Render modals once per project (outside rows for cleanliness)
  - projects.each do |project|
    - modal_id = "projectModal-#{project.id}"
    .modal.fade{ id: modal_id, tabindex: "-1", aria: { hidden: "true", labelledby: "#{modal_id}-label" } }
      .modal-dialog.modal-dialog-centered.modal-lg
        .modal-content
          .modal-header
            %h5.modal-title{ id: "#{modal_id}-label" }= project.project_name
            %button.btn-close{ type: "button", data: { bs_dismiss: "modal" }, aria: { label: "Close" } }
          .modal-body
            .ratio.ratio-16x9.mb-3
              %img.img-fluid.w-100.h-100{ src: image_path(project.project_img), alt: "#{project.project_name} full screenshot" }
            %p.mb-3= project.project_description
            .d-flex.flex-wrap.gap-2
              - if project.project_url.present?
                %a.btn.btn-primary{ href: project.project_url, target: "_blank", rel: "noopener" } Visit
              - if project.project_source_url.present?
                %a.btn.btn-outline-secondary{ href: project.project_source_url, target: "_blank", rel: "noopener" } Source
              - if project.project_stack.present?
                %span.badge.bg-secondary.align-self-center= project.project_stack
          .modal-footer
            %button.btn.btn-light{ type: "button", data: { bs_dismiss: "modal" } } Close
