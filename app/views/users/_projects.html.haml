-# locals: projects: (collection), row_count: (Integer, default 2)
- projects      ||= @projects || []
- row_count     ||= 2
- groups          = rows_by_tens(@projects)
- speeds          = [0.25, -0.15, 0.2, -0.18, 0.12, -0.1] # recycle if > 6 rows

%section#projects#works.bc-projects.py-6.home-section{ data: { row_count: row_count } }
  .container-xxl.mar-top-5p
    %h2.display-6.fw-bold.mb-4.text-center.white Projects
    %p.white.glow Pushed a few commits or so far... Only 42,000 to go!


    .bg-white-border
      - groups.each_with_index do |group, idx|
        - speed = speeds[idx % speeds.length]
        .bc-parallax-row.pad-3P-down{ data: { speed: speed } }
          .row.flex-nowrap.overflow-auto.gx-4.pb-3.parallax-row
            - group.each do |project|
              - modal_id = "projectModal-#{project.id}"
              .col-10.col-sm-6.col-md-4.col-lg-3
                %button.curved-6{ type: "button", "data-toggle" => "modal", "data-target" => "##{modal_id}" }
                  .ratio.ratio-16x9
                    %img.card-img-top{ src: image_path(project.project_img), alt: "#{project.project_name} screenshot", loading: "lazy" }
                  .card-body
                    %h5.card-title.mb-0= project.project_name
                    %small.text-muted
                      = [project.project_feature_lang, project.project_state.presence].compact.join(" \u2014 ")
