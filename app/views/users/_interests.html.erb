<!-- Interests -->
<div class="bg-site">
  <section id="interest" class="home-section">
    <div class="container">
      <div class="row">
        <div class="mx-auto d-block col-md-8">
        <div class="section-heading">
         <h2 class="black glow">Interests</h2>
         <p class="black glow">Areas I'd love to contribute to.</p>
        </div>
        </div>
      </div>

      <div class="row">

      <div class="col-xs-12 col-sm-6 col-md-6 col-lg-3">
        <div class="box-team wow rotateInUpLeft" data-wow-delay="0.1s">
          <h4 class="black glow">Robotics</h4>
          <%= image_tag("robo-logo2.png", :alt => "Roboto", class: "image-responsive max-200") %>
          <p class="black glow">IF/ELSE gates hit different when logic errors might actually crush your skull.</p>
          <hr class='red-breaker-bar d-block d-md-none mar-top-10p'>
        </div>
      </div>

      <div class="col-xs-12 col-sm-6 col-md-6 col-lg-3">
        <div class="box-team wow rotateInUpLeft" data-wow-delay="0.3s">
          <h4 class="black glow">Electric Vehicles</h4>
          <%= link_to image_tag("EV-2.png", :alt => "EV Bus Conversion", class: "image-responsive max-200"), "https://www.youtube.com/watch?v=M96c2vpPjPo", target: :_blank %>
          <p class="black glow">ZoomZoom <span class=red>></span> VroomVroom<br>Fun Fact: I built one from scratch before it was cool.</p>
          <hr class='red-breaker-bar d-block d-md-none mar-top-10p'>
        </div>
      </div>

      <div class="col-xs-12 col-sm-6 col-md-6 col-lg-3" >
        <div class="box-team wow rotateInUpLeft" data-wow-delay="0.7s">
            <h4 class="black glow">A.I.</h4>
            <%= image_tag("ai6.png", :alt => "A.I.", class: "image-responsive max-200") %>
            <p class="black glow">If the internet is a giant series of tubes then A.I. is just a giant series of gates.</p>
            <hr class='red-breaker-bar d-block d-md-none mar-top-10p'>
        </div>
      </div>

      <div class="col-xs-12 col-sm-6 col-md-6 col-lg-3">
        <div class="box-team wow rotateInUpLeft" data-wow-delay="0.5s">
          <h4 class="black glow">"Auto"-Mobiles</h4>
          <%= image_tag("automobile.png", :alt => "Self Drive", class: "image-responsive max-200") %>
          <p class="black glow">I'd give up the steering wheel in an instant if...<br>Everyone else did too.<br></p>
        </div>
      </div>

    </div>
  </section>
</div>
