.bg-site
  %section#services.home-section
    .container
      .row
        .mx-auto.d-block.col-md-8
          .section-heading
            %h2.black.glow The Stack
            %p.black.glow In all my life I've never seen a list I was so sure would be growing...Quickly
      .scrollable.overflow-auto
        - techs.in_groups_of(4, false).each_with_index do |group, oidx|
          .row
            - group.each_with_index do |tech, idx|
              .col-xs-12.col-sm-6.col-md-3.col-lg-3
                .tech-container.pad-5P-LR
                  = image_tag(tech.img, :alt => tech.title, id: "tech-img-#{oidx}#{idx}", class: "tech-item tech-img image-responsive")
                  .tech-item.tech-tip.d-none{ id: "tech-tip-#{oidx}#{idx}" }
                    %br
                    %h4.black.glow.text-center.tech-tag-line
                      = raw(tech.tag_line)
                    %p.black.glow.d-none.d-md-block
                      = raw(tech.copy)
