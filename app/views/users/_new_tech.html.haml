.bg-site
  %section#services.home-section
    -# .row
    -#   #breakpoint-xs.d-block.d-sm-none breakpoint-xs
    -#   #breakpoint-sm.d-none.d-sm-block.d-md-none breakpoint-sm
    -#   #breakpoint-md.d-none.d-md-block.d-lg-none breakpoint-md
    -#   #breakpoint-lg.d-none.d-lg-block.d-xl-none breakpoint-lg
    -#   #breakpoint-xl.d-none.d-xl-block.d-xxl-none breakpoint-xl
    -#   #breakpoint-xxl.d-none.d-xxl-block breakpoint-xxl
    .container
      .row
        .mx-auto.d-block.col-md-8
          .section-heading
            %h2.black.glow The Stack
            %p.black.glow In all my life I've never seen a list I was so sure would be growing...Quickly
      - techs.in_groups_of(4, false).each do |group|
        .row
          - group.each_with_index do |tech, idx|
            .mx-auto.col-xs-12.col-sm-6.col-md-3.col-lg-3
              .service-box.wow.bounceInUp.pad-5P-LR{"data-wow-delay" => "0.#{idx * 2 + 1}s"}
                = image_tag(tech.img, :alt => tech.title, class: "image-responsive")
                %br
                %h4.black.glow.text-center.tech-tag-line
                  = raw(tech.tag_line)
                %p.black.glow.d-none.d-md-block
                  = raw(tech.copy)
