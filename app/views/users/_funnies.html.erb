<!-- Funnies -->
<div class='bg-site'>
  <section id='giggles' class='home-section'>
    <div class='container'>
      <div class='row'>
        <div class='mx-auto d-block col-md-8'>
          <div class='section-heading'>
            <h2 class='black glow'>Finally</h2>
            <p class='black glow'>A giggle a day keeps the demons away.</p>
          </div>
        </div>
      </div>

      <div class='row'>
        <div class='col-xs-12 col-sm-12 col-md-12 col-lg-12'>
          <% dir = 'app/assets/images/giggles/' %>
          <% count = Dir[File.join(dir, '**', '*')].count { |file| File.file?(file) } %>
          <% giggle_img = "giggles/giggle_#{rand(0...count)}.png" %>
          <%= image_tag(giggle_img, alt: giggle_img, class: 'image-meme image-responsive max-500 pad-5P') %>
        </div>
      </div>
    </div>
  </section>
</div>
