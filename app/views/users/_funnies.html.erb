<%
  root         = Rails.root.join('app', 'assets', 'images')
  giggle_paths = Dir.glob(root.join('giggles', '**', '*.{png,jpg,jpeg,gif,webp,svg}').to_s, File::FNM_CASEFOLD)
                    .map { |f| image_path(f.sub("#{root}/", '')) }
%>
<!-- Funnies -->
<div class='bg-site'>
  <section id='giggles' class='home-section'>
    <div class='container'>
      <div class='row'>
        <div class='mx-auto d-block col-md-8'>
          <div id='comic-text' class='section-heading'>
            <h2 class='black glow'>Finally</h2>
            <p class='black glow'>A Giggle a day keeps the demons at bay</p>
          </div>
        </div>
      </div>

      <div class='row'>
        <div class='col-xs-12 col-sm-12 col-md-12 col-lg-12'>
          <div id="giggle_carousel" class="carousel slide"
               data-ride="carousel" data-keyboard="true" data-pause="hover"
               data-images="<%= giggle_paths.to_json %>">
            <div class="carousel-inner"><%# populated by giggles.js %></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
