-# locals: projects: (collection), row_count: (Integer, default 2)
- projects      ||= @projects || []
- row_count     ||= 2
- groups          = projects.in_groups(row_count, false)
- speeds          = [0.25, -0.15, 0.2, -0.18, 0.12, -0.1] # recycle if > 6 rows

-# Render modals once per project (outside rows for cleanliness)
%section#projects.bc-projects.py-6{ data: { row_count: row_count } }
  - projects.each do |project|
    - modal_id = "projectModal-#{project.id}"
    .modal.fade.project-modal{ id: modal_id, tabindex: "-1", aria: { hidden: "true", labelledby: "#{modal_id}-label" } }
      .modal-dialog.modal-dialog-centered.modal-lg
        .modal-content
          .modal-header
            %h5.modal-title{ id: "#{modal_id}-label" }= project.project_name
            %button.close{ type: "button", "data-dismiss" => "modal", "aria-label" => "Close" }
              %span{ "aria-hidden" => "true" } ×
          .modal-body
            .ratio.ratio-16x9.mb-3
              %img.img-fluid.w-100.h-100{ src: image_path(project.project_img), alt: "#{project.project_name} full screenshot" }
            - if project.project_url.present?
              %a.btn.btn-info{ href: project.project_url, target: "_blank", rel: "noopener" } Visit
            - if project.project_source_url.present? && project.project_source_url != 'closed'
              %a.btn.btn-success{ href: project.project_source_url, target: "_blank", rel: "noopener" } Source
            - else
              %a.btn.btn-danger Closed Source
            %p.mb-3
              - project.techs.each do |tech|
                %span.badge.bg-secondary.align-self-center= tech.title
            %p.mb-3.txt-black= project.project_description
          .modal-footer
            %button.close{ type: "button", "data-dismiss" => "modal", "aria-label" => "Close" } ×
