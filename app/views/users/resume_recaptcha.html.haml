= render partial: "layouts/sub_header"

%h2.glow.white
  GET/Resume
%h4.glow.white
  Access Restricted: Human's Only

%h4.glow.white
  Apologies for the delay. Personal data requires minimal verification

.container
  .img-container
    = image_tag 'no_bots.png', alt: 'no_bots_allowed', class: 'img-fluid centered'

  = form_tag '/resume' do
    .container.verification-container
      .h-100.d-flex.align-items-center.justify-content-center.pad-5
        .row
          .glow.col.col-lg-12.col-sm-12
            = label_tag(:request_email, "Step 1: Enter a valid email:")
            .align-items-center.justify-content-center.d-flex
              = text_field_tag(:request_email)
          .glow.col.col-lg-12.col-sm-12.margin-5p
            = label_tag(:recaptcha_copy, "Step 2: Verify via reCaptcha:")
            .align-items-center.justify-content-center.d-flex
              = recaptcha_tags
      = button_tag(type: "submit", class: "btn btn-info") do
        Give Resume NOW!

- space_rand = rand(1..5)
= render partial: "spacer#{space_rand}"
