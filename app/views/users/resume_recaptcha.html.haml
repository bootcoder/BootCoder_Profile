= render partial: "layouts/sub_header"

%h2.glow.white
  GET/Resume
%h4.glow.white
  Access Restricted: Human's Only

.container
  .img-container
    = image_tag 'no_bots.png', alt: 'no_bots_allowed', class: 'img-fluid centered curved-5'

  %p.white
    Access to personal information requires minimal verification
  = form_tag '/resume' do
    .glow
      = label_tag(:request_email, "Please enter a valid email address to access:")
      = text_field_tag(:request_email)
    .h-100.d-flex.align-items-center.justify-content-center.pad-5
      = recaptcha_tags
    = button_tag(type: "submit", class: "btn btn-info") do
      Give Resume NOW!
%h4.glow.white
  Apologies for the delay
