%h4.glow.red
  Access Restricted
%h4.glow.white
  GET/Resume<br>Human's Only
%h6.spacer.white.pad-5
  Apologies for the delay. Personal data requires minimal verification

.container
  .img-container
    = image_tag 'no_bots.png', alt: 'no_bots_allowed', class: 'img-fluid centered'

  = form_tag '/resume' do
    .container.verification-container
      .h-100.d-flex.align-items-center.justify-content-center.pad-5
        .row
          .glow.col.col-lg-12.col-sm-12.margin-1p
            = label_tag(:version, "Step 1: Select version:", class: 'resume-label')
            .align-items-center.justify-content-center.d-flex
              .btn-group.btn-group-toggle{"data-toggle" => "buttons"}
                %label.btn.btn-outline-secondary.active
                  = radio_button_tag :version, 'verbose', true, id: 'verbose'
                  Verbose
                %label.btn.btn-outline-secondary
                  = radio_button_tag :version, 'concise', false, id: 'concise'
                  Concise
                %label.btn.btn-outline-secondary
                  = radio_button_tag :version, 'virtual', false, id: 'virtual'
                  Virtual
                %label.btn.btn-outline-secondary
                  = radio_button_tag :version, 'visual', false, id: 'visual'
                  View-Only
          .glow.col.col-lg-12.col-sm-12
            = label_tag(:request_email, "Step 2: Enter valid email:", class: 'resume-label')
            .align-items-center.justify-content-center.d-flex
              = text_field_tag(:request_email)
          .glow.col.col-lg-12.col-sm-12.margin-1p
            = label_tag(:recaptcha_copy, "Step 3: Verify reCaptcha:", class: 'resume-label')
            .align-items-center.justify-content-center.d-flex
              = recaptcha_tags
      .form-group.mt-3
        - if Flipper.enabled?(:resume_download)
          = submit_tag 'Download PDF', class: 'btn btn-bootcoder rounded-pill resume-submit'
        - else
          = button_to('Download Disabled (Flipper)', '412.html', method: :get, class: 'btn btn-warning rounded-pill')

- space_rand = rand(1..5)
= render partial: "spacer#{space_rand}"
